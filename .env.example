# PostHog — analytics en mode vie privée, cloud UE
# Copier ce fichier en .env.local et renseigner la clé de projet PostHog (commence par "phc_")
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase — prise de rendez-vous (Settings > API du projet Supabase)
# En local : valeurs affichées par `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Notifications push de l'admin (clé publique VAPID ; la clé privée va dans les secrets Supabase VAPID_KEYS)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
